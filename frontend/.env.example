# Leave unset when the FastAPI container serves this bundle (same origin) or
# when running `npm run dev` (vite.config.js proxies /analyze* to :8000).
#
# Set it only when the UI is deployed apart from the API — e.g. a Vercel
# frontend calling a Hugging Face Space:
# VITE_API_URL=https://<user>-truth-shield.hf.space
VITE_API_URL=
