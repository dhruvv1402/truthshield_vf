# Copy to backend/.env and fill in. Never commit the real file.

# Powers the reasoning agent (Agent / Both modes).
# Free key: https://build.nvidia.com  ->  any model page  ->  "Get API Key"
NVIDIA_API_KEY=

# Powers live web verification. Free tier: 100 requests/day.
# https://gnews.io/  ->  sign up  ->  copy the API key
GNEWS_API_KEY=

# --- optional overrides -------------------------------------------------
# MODELS_DIR=/absolute/path/to/models
# PHASE1_DIR=/absolute/path/to/phase1_roberta_fulltune/best
# PHASE2_HEAD=/absolute/path/to/phase2_fusion_head/fusion_head.pt
# FRONTEND_DIST=/absolute/path/to/frontend/dist
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
# PORT=8000
